<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <CheckBox
                android:id="@+id/CBHudEnable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wlm_show_hud"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout style="@style/FieldSet">
                    <CheckBox
                        android:id="@+id/CBHudFPS"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wlm_show_fps" />

                    <CheckBox
                        android:id="@+id/CBHudGraph"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wlm_show_frame_time_graph" />

                    <CheckBox
                        android:id="@+id/CBHudLows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wlm_show_1_0_1_lows" />

                    <CheckBox
                        android:id="@+id/CBHudRenderer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wlm_show_renderer" />

                    <CheckBox
                        android:id="@+id/CBHudVertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wlm_vertical_layout" />

                    <CheckBox
                        android:id="@+id/CBHudWrapper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wlm_show_wrapper_name" />

                    <CheckBox
                        android:id="@+id/CBHudLocked"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wlm_lock_hud_position" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wlm_disables_dragging_and_orientation_toggling_via_touch"
                        android:textSize="10sp"
                        android:textColor="#888888"
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="-4dp" />
                </LinearLayout>
                <TextView style="@style/FieldSetLabel" android:text="@string/wlm_performance" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <LinearLayout style="@style/FieldSet">
                    <CheckBox
                        android:id="@+id/CBHudGPU"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wlm_show_gpu_load" />

                    <CheckBox
                        android:id="@+id/CBHudCPU"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wlm_show_cpu_load" />

                    <CheckBox
                        android:id="@+id/CBHudCPUTemp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wlm_show_cpu_temperature" />

                    <CheckBox
                        android:id="@+id/CBHudRAM"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wlm_show_ram_usage" />

                    <CheckBox
                        android:id="@+id/CBHudBattery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wlm_show_battery_power" />

                    <CheckBox
                        android:id="@+id/CBHudBatteryPct"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wlm_show_battery_percentage" />
                </LinearLayout>
                <TextView style="@style/FieldSetLabel" android:text="@string/wlm_hardware_info" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <LinearLayout style="@style/FieldSet">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/wlm_hud_look_and_style"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                        <Spinner
                            android:id="@+id/SPHudStyle"
                            style="@style/ComboBox"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="4dp"
                            android:spinnerMode="dropdown" />

                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/CBHudBorder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wlm_show_border" />

                    <CheckBox
                        android:id="@+id/CBHudCompact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wlm_compact_mode" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/wlm_transparency"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/TVHudAlpha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/SBHudAlpha"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:splitTrack="false"
                        android:max="100" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/wlm_scale"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/TVHudScale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.0x"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/SBHudScale"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:splitTrack="false"
                        android:max="100" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wlm_position_preset"
                        android:layout_marginTop="8dp"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                    <Spinner
                        android:id="@+id/SPHudPreset"
                        style="@style/ComboBox"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:spinnerMode="dropdown"
                        android:layout_marginBottom="4dp" />
                </LinearLayout>
                <TextView style="@style/FieldSetLabel" android:text="@string/wlm_appearance" />
            </FrameLayout>

            <Button
                android:id="@+id/BTHudReset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wlm_reset_to_defaults"
                android:layout_marginTop="16dp"
                style="@style/ButtonNeutral" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
