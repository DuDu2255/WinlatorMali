<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:layout_width="340dp"
    android:layout_height="300dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- ============================================================ -->
        <!-- Color Preset                                                 -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bordered_panel_dark"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wlm_color_preset"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/SColorPreset"
                style="@style/ComboBox"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:spinnerMode="dropdown" />

            <LinearLayout
                android:id="@+id/LLPresetStrength"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorSecondary"
                    android:text="@string/wlm_strength" />

                <com.winlator.cmod.widget.SeekBar
                    android:id="@+id/SBPresetStrength"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    app:sbMaxValue="100"
                    app:sbMinValue="0"
                    app:sbStep="5" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- Upscaler                                                     -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bordered_panel_dark"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wlm_upscaler"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wlm_scales_the_container_resolution_to_your_screen_sgsr_and_fsr_give_the_sharpest_result"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/SUpscaler"
                style="@style/ComboBox"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:spinnerMode="dropdown" />

            <LinearLayout
                android:id="@+id/LLUpscalerSharpness"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorSecondary"
                    android:text="@string/wlm_upscaler_sharpness" />

                <com.winlator.cmod.widget.SeekBar
                    android:id="@+id/SBUpscalerSharpness"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    app:sbMaxValue="100"
                    app:sbMinValue="0"
                    app:sbStep="5" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/CBFitGameWindow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/wlm_fit_game_window_to_screen" />

            <TextView
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wlm_upscales_a_game_running_smaller_than_the_container_e_g_800x600_on_1280x720_straight_to_your_screen_with_the_selected_upscaler_keeping_its_aspect_ratio" />
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- Sharpening                                                   -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bordered_panel_dark"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wlm_sharpening"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/SSharpenMode"
                style="@style/ComboBox"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:spinnerMode="dropdown" />

            <LinearLayout
                android:id="@+id/LLSharpenSettings"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorSecondary"
                    android:text="@string/wlm_sharpening_level" />

                <com.winlator.cmod.widget.SeekBar
                    android:id="@+id/SBSharpenLevel"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    app:sbMaxValue="5.0"
                    app:sbMinValue="1.0"
                    app:sbStep="1.0" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- Advanced (collapsed): color adjustment + effects             -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bordered_panel_dark"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/LLAdvancedHeader"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/wlm_advanced_color_and_effects"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/IVAdvancedArrow"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/icon_list_item_folded"
                    android:contentDescription="Expand"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LLAdvanced"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:text="@string/brightness" />

                <com.winlator.cmod.widget.SeekBar
                    android:id="@+id/SBBrightness"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    app:sbMaxValue="100"
                    app:sbMinValue="-100"
                    app:sbStep="1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:text="@string/contrast" />

                <com.winlator.cmod.widget.SeekBar
                    android:id="@+id/SBContrast"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    app:sbMaxValue="100"
                    app:sbMinValue="-100"
                    app:sbStep="1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:text="@string/gamma" />

                <com.winlator.cmod.widget.SeekBar
                    android:id="@+id/SBGamma"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    app:sbMaxValue="3.0"
                    app:sbMinValue="0.5"
                    app:sbStep="0.05" />

                <CheckBox
                    android:id="@+id/CBEnableHDR"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wlm_fake_hdr_bloom_contrast" />

                <CheckBox
                    android:id="@+id/CBEnableFXAA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wlm_fxaa_anti_aliasing" />

                <CheckBox
                    android:id="@+id/CBEnableToon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wlm_toon_outlines" />

                <CheckBox
                    android:id="@+id/CBEnableCRT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wlm_crt_scanlines" />

                <CheckBox
                    android:id="@+id/CBEnableNTSC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wlm_ntsc_signal" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- Universal FPS Limiter                                        -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bordered_panel_dark"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/wlm_fps_limiter"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/IVFPSLimitInfo"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_driver_info"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Info"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <Spinner
                android:id="@+id/SFPSLimit"
                style="@style/ComboBox"
                android:entries="@array/fps_limit_entries"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:spinnerMode="dropdown" />

            <EditText
                android:id="@+id/ETCustomFPSLimit"
                style="@style/EditText"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:inputType="number"
                android:hint="Custom FPS limit (e.g. 40, 72, 144)"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- Frame Generation                                             -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bordered_panel_dark"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/wlm_frame_generation_zerofg"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/IVFrameGenInfo"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_driver_info"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Info"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/CBFrameGen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wlm_enable_frame_generation" />

            <TextView
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/wlm_mode" />

            <Spinner
                android:id="@+id/SFrameGenTarget"
                style="@style/ComboBox"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="2dp"
                android:spinnerMode="dropdown" />

            <TextView
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/wlm_quality" />

            <Spinner
                android:id="@+id/SFrameGenQuality"
                style="@style/ComboBox"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="2dp"
                android:spinnerMode="dropdown" />
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- Save                                                         -->
        <!-- ============================================================ -->
        <Button
            android:id="@+id/BTSaveForGame"
            style="@style/ButtonNeutral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wlm_save_for_this_game" />

        <Button
            android:id="@+id/BTSaveAsDefault"
            style="@style/ButtonNeutral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/wlm_save_as_container_default" />

        <Button
            android:id="@+id/BTResetEnhancements"
            style="@style/ButtonNeutral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/reset" />

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />
    </LinearLayout>
</ScrollView>
