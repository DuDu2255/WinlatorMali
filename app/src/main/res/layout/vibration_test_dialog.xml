<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Controllers -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/wlm_controllers"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="?attr/colorAccent" />

            <Button
                android:id="@+id/BTRescanDevices"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="?android:attr/selectableItemBackground"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/wlm_rescan"
                android:textAllCaps="false"
                android:textColor="#3D82FF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bordered_panel_dark"
            android:padding="12dp"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/TVDeviceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorPrimary"
                android:text="@string/wlm_looking_for_controllers" />

            <Button
                style="@style/ButtonPositive"
                android:id="@+id/BTGrantUsbPermission"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="14sp"
                android:text="@string/grant_usb_permission"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Test / Stop, right under the status so they're visible without scrolling -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <Button
                style="@style/ButtonPositive"
                android:id="@+id/BTStartTest"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="2"
                android:layout_marginEnd="6dp"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="16sp"
                android:text="@string/wlm_test_vibration" />

            <Button
                style="@style/ButtonNeutral"
                android:id="@+id/BTStopTest"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="16sp"
                android:text="@string/wlm_stop" />
        </LinearLayout>

        <!-- Test settings -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wlm_test_settings"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="?attr/colorAccent"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bordered_panel_dark"
            android:padding="12dp"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wlm_motor"
                android:textSize="12.5sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="4dp" />

            <Spinner
                style="@style/ComboBox"
                android:id="@+id/SMotorMode"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:spinnerMode="dropdown" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wlm_strength"
                    android:textSize="12.5sp"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:id="@+id/TVIntensityPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textStyle="bold"
                    android:textSize="12.5sp"
                    android:textColor="?attr/colorAccent" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/SBIntensity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="100" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wlm_duration"
                android:textSize="12.5sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp" />

            <Spinner
                style="@style/ComboBox"
                android:id="@+id/SDuration"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:spinnerMode="dropdown" />
        </LinearLayout>

        <!-- Where to send the test -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wlm_vibrate_on"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="?attr/colorAccent"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bordered_panel_dark"
            android:padding="8dp"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <CheckBox
                android:id="@+id/CBUsbDirect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:textSize="13sp"
                android:text="@string/wlm_usb_controller_direct" />

            <CheckBox
                android:id="@+id/CBAndroidInputDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:textSize="13sp"
                android:text="@string/wlm_bluetooth_other_controllers" />

            <CheckBox
                android:id="@+id/CBPhoneFallback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:textSize="13sp"
                android:text="@string/wlm_phone_to_check_the_test_is_running" />
        </LinearLayout>

        <!-- Log -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wlm_log"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="?attr/colorAccent"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="@drawable/bordered_panel_dark"
            android:padding="8dp"
            android:orientation="vertical">

            <ScrollView
                android:id="@+id/SVLog"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/TVLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:typeface="monospace"
                    android:textSize="11sp"
                    android:textColor="#E0E0E0"
                    android:text="@string/wlm_ready" />
            </ScrollView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
